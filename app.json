{
  "expo": {
    "name": "Market Association",
    "slug": "market-association-record-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF9F6"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.marketassociation.records",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Capture member photos and ID-proof images for the association's register.",
        "NSPhotoLibraryUsageDescription": "Attach member photos and ID-proof images from your library."
      }
    },
    "android": {
      "package": "com.marketassociation.records",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FBF9F6"
      },
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ],
      "versionCode": 1
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Market Association to attach member photos, ID-proof images and bill photos.",
          "cameraPermission": "Allow Market Association to capture member photos, ID-proof images and bill photos."
        }
      ],
      "expo-asset",
      [
        "react-native-share",
        {
          "android": [
            "com.whatsapp"
          ]
        }
      ]
    ]
  }
}
